# Скопируйте в .env и заполните. Файл .env с секретами не коммитьте.
# Загрузка: python-dotenv в app/config.py (load_dotenv при импорте).

# --- Блокер старта (обязательно) ---
# Токен от @BotFather. Без него load_settings() падает с ValueError.
BOT_TOKEN=

# --- Хранилище (app/main.py) ---
# По умолчанию: json — файлы в data/ (см. storage_filejson). Для продакшена обычно нужен sqlite.
# BOT_STORAGE_BACKEND=json
BOT_STORAGE_BACKEND=sqlite

# Путь к одному файлу SQLite (все репозитории в одном файле).
# По умолчанию, если переменная не задана: <корень_проекта>/data/bot2.sqlite3
# SQLITE_DB_PATH=

# --- Админы Telegram (app/config.py -> Settings.admin_ids) ---
# Список user_id через запятую. Пусто = никто не пройдёт _is_admin в admin_handlers.
ADMIN_IDS=

# --- Услуги и витрина (app/config.py) ---
# Пусто = дефолтный список из трёх услуг в коде (_parse_services).
# SERVICES=
# Параллельно SERVICES: цены и длительности (через запятую, по позициям). Пусто = «—» и SLOT_DURATION_MINUTES как текст длительности по умолчанию.
# SERVICE_PRICES=
# SERVICE_DURATIONS_MIN=
# SLOT_DURATION_MINUTES=60
# Окно дней: используется в админке (_admin_dates), не подмешивается в клиентский _available_dates в booking_handlers (там жёстко до 30 дней в коде).
# MAX_DAYS_AHEAD=7

# Тексты салона для клиентского меню (fallback, если в БД нет переопределений).
# SALON_ADDRESS=
# SALON_CONTACTS=
